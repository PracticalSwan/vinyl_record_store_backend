{
  "name": "vinyl_record_store_backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API and explainable demo recommender for an academic vinyl record store.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:ping": "node --env-file-if-exists=.env.local scripts/ping-mongodb.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-mongodb.mjs",
    "db:seed:apply": "node --env-file-if-exists=.env.local scripts/seed-mongodb.mjs --apply",
    "db:seed:users": "node --env-file-if-exists=.env.local scripts/seed-demo-users.mjs",
    "db:seed:users:apply": "node --env-file-if-exists=.env.local scripts/seed-demo-users.mjs --apply",
    "db:indexes": "node --env-file-if-exists=.env.local scripts/verify-indexes.mjs",
    "db:indexes:ensure": "node --env-file-if-exists=.env.local scripts/verify-indexes.mjs --ensure",
    "db:clean:test": "node --env-file-if-exists=.env.local scripts/clean-test-residue.mjs",
    "db:clean:test:apply": "node --env-file-if-exists=.env.local scripts/clean-test-residue.mjs --apply",
    "catalog:import": "node --env-file-if-exists=.env.local scripts/import-catalog.mjs",
    "catalog:artwork:propose": "node scripts/propose-artwork-curation.mjs --output=output/artwork-proposals.json --html=output/artwork-review.html",
    "catalog:artwork:build": "node scripts/build-artwork-manifest.mjs --input=output/artwork-proposals.json --output=src/data/artworkManifest.js",
    "catalog:artwork:download": "node scripts/download-local-artwork.mjs",
    "catalog:artwork:verify": "node scripts/download-local-artwork.mjs --check",
    "dataset:profile": "node --env-file-if-exists=.env.local scripts/prepare-amazon-dataset.mjs --profile-only",
    "dataset:identity:build": "node scripts/build-amazon-identity-registry.mjs",
    "dataset:identity:build:apply": "node scripts/build-amazon-identity-registry.mjs --apply",
    "dataset:prepare": "node --env-file-if-exists=.env.local scripts/prepare-amazon-dataset.mjs",
    "dataset:artwork:enrich": "node --env-file-if-exists=.env.local scripts/enrich-amazon-artwork.mjs",
    "dataset:artwork:download": "node --env-file-if-exists=.env.local scripts/download-amazon-artwork.mjs",
    "dataset:artwork:verify": "node --env-file-if-exists=.env.local scripts/download-amazon-artwork.mjs --check",
    "dataset:import": "node --env-file-if-exists=.env.local scripts/import-amazon-dataset.mjs",
    "dataset:import:apply": "node --env-file-if-exists=.env.local scripts/import-amazon-dataset.mjs --apply",
    "dataset:activate:apply": "node --env-file-if-exists=.env.local scripts/import-amazon-dataset.mjs --apply --activate",
    "dataset:clean:failed": "node --env-file-if-exists=.env.local scripts/cleanup-failed-amazon-import.mjs",
    "dataset:clean:failed:apply": "node --env-file-if-exists=.env.local scripts/cleanup-failed-amazon-import.mjs --apply",
    "dataset:rollback": "node --env-file-if-exists=.env.local scripts/rollback-amazon-dataset.mjs",
    "dataset:rollback:apply": "node --env-file-if-exists=.env.local scripts/rollback-amazon-dataset.mjs --apply",
    "dataset:evaluation:readiness": "node --env-file-if-exists=.env.local scripts/report-amazon-evaluation-readiness.mjs",
    "dataset:verify": "node --env-file-if-exists=.env.local scripts/verify-amazon-dataset.mjs",
    "recommender:evaluate": "node --env-file-if-exists=.env.local scripts/evaluate-recommender.mjs",
    "recommender:evaluate:historical": "node --env-file-if-exists=.env.local scripts/evaluate-historical-recommender.mjs",
    "recommender:evaluate:historical:mf": "node --env-file-if-exists=.env.local scripts/run-historical-mf-experiment.mjs",
    "auth:hash": "node scripts/create-password-hash.mjs",
    "lint": "eslint",
    "test": "node --test"
  },
  "dependencies": {
    "mongoose": "^9.7.3",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
